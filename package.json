{
  "name": "@dsh-external/dsh-super-injector",
  "version": "0.3.3-dsh.20261028.1",
  "description": "dsh-routing-suite \u5206\u53d1\u5165\u53e3\uff1aDSH \u8d85\u7ea7\u6a21\u7ec4\u6ce8\u5165\u5668\uff08BepInEx \u5f0f\u8fd0\u884c\u65f6\u6ce8\u5165\uff0c\u514d\u91cd\u542f\uff09+ router-standard \u9884\u8bbe\u4ed3\u5e93\u3002\u63d2\u4ef6\u5165\u53e3\u4e3a injector/\uff0c\u9884\u8bbe\u4f4d\u4e8e preset/\u3002",
  "private": true,
  "scripts": {
    "prepare": "node injector/scripts/prepare.mjs"
  },
  "type": "module",
  "main": "./injector/lib/index.js",
  "types": "./injector/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./injector/lib/types/index.d.ts",
      "default": "./injector/lib/index.js"
    },
    "./client": {
      "types": "./injector/lib/types/client/index.d.ts",
      "default": "./injector/lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "injector/lib",
    "injector/scripts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "injector",
    "super-injector",
    "preset",
    "router-standard",
    "cordis",
    "progressive-disclosure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjh051108/dsh-routing-suite.git"
  },
  "homepage": "https://github.com/yjh051108/dsh-routing-suite",
  "bugs": {
    "url": "https://github.com/yjh051108/dsh-routing-suite/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.1 || ^0.2.0-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2 || ^3.18.6-alpha.1"
  }
}
